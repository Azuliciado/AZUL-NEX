<Window x:Class="AzulNex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AZUL NEX" Height="740" Width="1120" MinHeight="600" MinWidth="900"
        Background="#090B12" Foreground="#F4F7FC" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0D1220" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="AZUL NEX" FontSize="25" FontWeight="Bold" Foreground="#4DA3FF"/>
                    <TextBlock Text="ONE PC. INFINITE DEVICES." FontSize="9" Foreground="#8795AA" Margin="0,4,0,28"/>
                    <TextBlock Text="WORKSPACE" Foreground="#63738B" FontSize="10" Margin="0,0,0,12"/>
                    <Button Content="Dashboard" Padding="10" Margin="0,2"/>
                    <Button Content="Device Installer" Click="DeviceInstaller_Click" Padding="10" Margin="0,2" Background="#173B68" Foreground="White" BorderThickness="0"/>
                    <Button Content="Device Library" Click="Library_Click" Padding="10" Margin="0,2"/>
                    <Button Content="My Devices" Click="Refresh_Click" Padding="10" Margin="0,2"/>
                    <Button Content="Input Controls" Click="Controls_Click" Padding="10" Margin="0,2"/>
                    <Button Content="APK Installer" Click="Install_Click" Padding="10" Margin="0,2"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="DEVELOPED BY AZULICIADO  •  ALPHA" Foreground="#65748A" FontSize="9" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Device dashboard" FontSize="27" FontWeight="SemiBold"/>
                    <TextBlock Text="Manage Android Virtual Devices running on this PC" Foreground="#9AA8BC" Margin="0,5,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Padding="18,10" Background="#173B68" Foreground="White" BorderThickness="0"/>
            </DockPanel>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,22,0,18">
                <Border Background="#111827" CornerRadius="10" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="ANDROID SDK" Foreground="#8FA0B8" FontSize="10"/><TextBlock x:Name="SdkStatus" Text="Checking…" FontSize="16" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Background="#111827" CornerRadius="10" Padding="16" Margin="4,0"><StackPanel><TextBlock Text="AVAILABLE AVDs" Foreground="#8FA0B8" FontSize="10"/><TextBlock x:Name="AvdCount" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Background="#111827" CornerRadius="10" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="RUNNING EMULATORS" Foreground="#8FA0B8" FontSize="10"/><TextBlock x:Name="RunningCount" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                <Border Background="#111827" CornerRadius="12" Padding="16" Margin="0,0,10,0">
                    <DockPanel><TextBlock DockPanel.Dock="Top" Text="Configured virtual devices" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="AvdList" Background="#0B111D" Foreground="White" BorderThickness="0"/></DockPanel>
                </Border>
                <Border Grid.Column="1" Background="#111827" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Device actions" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Button Content="Launch selected AVD" Click="Launch_Click" Padding="9" Margin="0,3" Background="#1768C5" Foreground="White" BorderThickness="0"/>
                        <Button Content="Stop selected emulator" Click="Stop_Click" Padding="9" Margin="0,3"/>
                        <TextBlock Text="Running devices" FontWeight="SemiBold" Margin="0,16,0,7"/>
                        <ListBox x:Name="RunningList" Height="100" Background="#0B111D" Foreground="White" BorderThickness="0"/>
                        <TextBlock Text="Navigation controls" FontWeight="SemiBold" Margin="0,16,0,7"/>
                        <UniformGrid Columns="3"><Button Content="Back" Click="Back_Click" Margin="2"/><Button Content="Home" Click="Home_Click" Margin="2"/><Button Content="Recent" Click="Recent_Click" Margin="2"/></UniformGrid>
                        <TextBlock Text="Install Android versions and create device profiles from Device Installer." Foreground="#8FA0B8" TextWrapping="Wrap" FontSize="11" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="Ready" Foreground="#8FA0B8" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</Window>