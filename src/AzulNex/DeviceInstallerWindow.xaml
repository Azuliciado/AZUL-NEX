<Window x:Class="AzulNex.DeviceInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AZUL NEX — Device Installer" Height="720" Width="980"
        MinHeight="650" MinWidth="900" WindowStartupLocation="CenterOwner"
        Background="#090B12" Foreground="#F4F7FC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#173B68"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B111D"/>
            <Setter Property="Foreground" Value="#101827"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,7,0,16"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B111D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#26364D"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,7,0,16"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="DEVICE INSTALLER" Foreground="#55A7FF" FontSize="11" FontWeight="Bold" CharacterSpacing="2"/>
            <TextBlock Text="Build your virtual device" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,4"/>
            <TextBlock Text="Choose a hardware profile and Android release. AZUL NEX downloads the official SDK image and creates the emulator for you." Foreground="#9AA8BC" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#111827" CornerRadius="14" Padding="22" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="01  DEVICE MODEL" Foreground="#55A7FF" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="What device should this emulator resemble?" Foreground="#DCE5F2" Margin="0,6,0,0"/>
                    <ComboBox x:Name="DeviceCombo" DisplayMemberPath="Name" SelectionChanged="SelectionChanged"/>
                    <TextBlock Text="02  ANDROID VERSION" Foreground="#55A7FF" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Choose the Android system image to install" Foreground="#DCE5F2" Margin="0,6,0,0"/>
                    <ComboBox x:Name="AndroidVersionCombo" DisplayMemberPath="Label" SelectionChanged="SelectionChanged"/>
                    <TextBlock Text="03  VIRTUAL DEVICE NAME" Foreground="#55A7FF" FontSize="11" FontWeight="Bold"/>
                    <TextBox x:Name="AvdNameBox" Text="AZUL_Pixel_API_36"/>
                    <CheckBox x:Name="LicenseCheckBox" Foreground="#B8C5D8" Content="I agree to review and accept the Android SDK component licenses" IsChecked="False" Margin="0,0,0,18" TextWrapping="Wrap"/>
                    <Button x:Name="InstallButton" Content="↓   INSTALL DEVICE" Click="Install_Click" Height="46" Background="#1768C5"/>
                    <ProgressBar x:Name="InstallProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,16,0,8"/>
                    <TextBlock x:Name="StatusText" Text="Ready when you are. Select a device and Android version." Foreground="#9AA8BC" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#0D1422" BorderBrush="#1D2B40" BorderThickness="1" CornerRadius="14" Padding="22">
                <StackPanel>
                    <TextBlock Text="INSTALLATION DETAILS" Foreground="#55A7FF" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="What gets installed?" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,14"/>
                    <TextBlock Text="Android system image" FontWeight="SemiBold"/>
                    <TextBlock Text="The selected Android release with Google APIs, using the x86_64 image for the Windows Android Emulator." Foreground="#9AA8BC" TextWrapping="Wrap" Margin="0,5,0,16"/>
                    <TextBlock Text="Device hardware profile" FontWeight="SemiBold"/>
                    <TextBlock Text="A supported emulator profile supplies the virtual screen size and hardware configuration. It does not install manufacturer firmware." Foreground="#9AA8BC" TextWrapping="Wrap" Margin="0,5,0,16"/>
                    <TextBlock Text="SDK components" FontWeight="SemiBold"/>
                    <TextBlock Text="AZUL NEX also checks for Android Platform-Tools and the matching Android platform package." Foreground="#9AA8BC" TextWrapping="Wrap" Margin="0,5,0,16"/>
                    <Border Background="#17243A" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                        <TextBlock Text="TIP  Emulators can use a lot of RAM and CPU. Start with one device and a lower-resolution profile on older PCs." Foreground="#B9D8FF" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="AZUL NEX  •  OFFICIAL ANDROID SDK COMPONENTS" Foreground="#63738B" FontSize="10" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="CLOSE" Click="Close_Click" Background="#202B3B" Padding="18,9"/>
        </DockPanel>
    </Grid>
</Window>